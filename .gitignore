# Dependencies
node_modules/

# Rust / wasm-pack build outputs
rust-wasm/target/
rust-wasm/pkg/
rust-wasm/pkg-dl/

# Built WASM bundles: build.sh copies them here and the deploy builds them fresh, so nothing in
# wasm/ is tracked.
wasm/*

# Site staging directory assembled by .github/workflows/build-pages.yml
deploy/

# Test coverage (npm run test:coverage)
coverage/

# Local imaging data and model weights; never commit subject data
data/
*.nii
*.nii.gz
models/*.onnx

# Local checkouts and drafts kept alongside the repo
QSM.jl/
ROMEO.jl/
MriResearchTools.jl/
paper/

# Python (serve.py and helper scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# Logs
*.log
npm-debug.log*

# Environment variables and secrets
.env
.env.*
*.pem
*.key

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
