    "mermaid": "flowchart TD\n    load[\"Load<br/><small><b>computed</b></small>\"]\n    scale_phase[\"Phase scaling<br/><small><b>computed</b></small>\"]\n    magnitude[\"Combined magnitude<br/><i>root sum of squares</i><br/><small>inhomogeneity correction</small><br/><small><b>computed</b></small>\"]\n    mask[\"Brain mask<br/><small>phase quality: Otsu threshold, dilation, hole-filling, erosion</small><br/><small><b>computed</b></small>\"]\n    unwrap[\"Field map<br/><i>ROMEO</i><br/><small>phase offsets removed</small><br/><small>B0 by weighted average</small><br/><small><b>computed</b></small>\"]\n    bgremove[\"Background-field removal<br/><i>V-SHARP</i><br/><small>SMV kernel radii from 12 to 1 mm</small><br/><small><b>computed</b></small>\"]\n    invert[\"Dipole inversion<br/><i>iLSQR</i><br/><small><b>computed</b></small>\"]\n    reference[\"Referencing<br/><i>mean</i><br/><small><b>computed</b></small>\"]\n    load -->|\"Phase (as acquired), Magnitude (as acquired)\"| scale_phase\n    scale_phase -->|\"Magnitude\"| magnitude\n    scale_phase -->|\"Phase, Magnitude\"| mask\n    scale_phase -->|\"Phase, Magnitude\"| unwrap\n    mask -->|\"Brain mask\"| unwrap\n    unwrap -->|\"Total field\"| bgremove\n    mask -->|\"Brain mask\"| bgremove\n    bgremove -->|\"Local field, Local field mask\"| invert\n    invert -->|\"Unreferenced susceptibility\"| reference\n    bgremove -->|\"Local field mask\"| reference\n",
    "differs": false
  },
  "methods": {
    "sentences": [
      {
        "text": "QSM processing was performed using QSMbly (Stewart, 2026).",
        "steps": [],
        "citations": [
          "stewart2026qsmbly"
        ]
      },
      {
        "text": "Inhomogeneity correction (Eckstein et al., 2019) was applied to the RSS-combined magnitude image.",
        "steps": [
          "magnitude"
        ],
        "citations": [
          "eckstein2019"
        ]
      },
      {
        "text": "A brain mask was generated using Otsu thresholding (Otsu, 1979) of the ROMEO phase quality map (computed from phase data and the inhomogeneity-corrected RSS-combined magnitude), followed by dilation, hole-filling, and erosion.",
        "steps": [
          "mask"
        ],
        "citations": [
          "dymerska2021",
          "otsu1979"
        ]
      },
      {
        "text": "Phase offset removal was performed using the HIP method (Eckstein et al., 2018).",
        "steps": [
          "unwrap"
        ],
        "citations": [
          "eckstein2018"
        ]
      },
      {
        "text": "Phase unwrapping was performed using ROMEO (Dymerska et al., 2021).",
        "steps": [
          "unwrap"
        ],
        "citations": [
          "dymerska2021"
        ]
      },
      {
        "text": "The B0 field map was estimated as a weighted average of the unwrapped echo phases.",
        "steps": [
          "unwrap"
        ],
        "citations": []
      },
      {
        "text": "Background field removal was performed using V-SHARP (Wu et al., 2012).",
        "steps": [
          "bgremove"
        ],
        "citations": [
          "wu2012"
        ]
      },
      {
        "text": "Dipole inversion was performed using iLSQR (Li et al., 2015).",
        "steps": [
          "invert"
        ],
        "citations": [
          "li2015"
        ]
      },
      {
        "text": "Susceptibility values were referenced to the mean susceptibility within the reconstruction mask (the brain mask less any rim eroded by background field removal).",
        "steps": [
          "reference"
        ],
        "citations": []
      }
    ],
    "references": [
      {
